# Cuenta Gmail que envía. Requiere verificación en 2 pasos activada.
SMTP_USER=tu_cuenta@gmail.com
# Contraseña de APLICACIÓN de 16 caracteres (https://myaccount.google.com/apppasswords), no la contraseña normal.
SMTP_PASS=xxxxxxxxxxxxxxxx
# Destinatarios, separados por coma.
MAIL_TO=destino1@gmail.com,destino2@correo.com
MAIL_FROM_NAME=Monitor de Contrataciones

# Palabras clave, separadas por coma. Cada una puede ser una palabra o una frase:
#   software                         la palabra y sus variantes (softwares)
#   sistema de seguridad ciudadana   todas esas palabras, en cualquier parte de la descripción
#   "sistema académico"              entre comillas: las palabras tienen que ir juntas
#                                    ("sistema de gestión académica" sí; "sistema de aire ... académicos" no)
# Escríbelas con tilde: el bot busca también la versión sin tilde ("maíz" busca "maiz").
# Si una frase trae resultados que no te sirven, ponla entre comillas o hazla más específica.
PALABRAS_CLAVE=software,"sistema académico",sistema de seguridad ciudadana
