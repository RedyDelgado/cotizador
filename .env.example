# Cuenta Gmail que envía. Requiere verificación en 2 pasos activada.
SMTP_USER=tu_cuenta@gmail.com
# Contraseña de APLICACIÓN de 16 caracteres (https://myaccount.google.com/apppasswords), no la contraseña normal.
SMTP_PASS=xxxxxxxxxxxxxxxx
# Destinatarios, separados por coma. Todos reciben el MISMO informe.
MAIL_TO=destino1@gmail.com,destino2@correo.com
MAIL_FROM_NAME=Monitor de Contrataciones

# Avisos técnicos (una fuente o un envío que falló). Si no lo defines, van a MAIL_TO.
# MAIL_ALERTAS=tu_correo@gmail.com

# ¿Quieres que cada correo reciba cosas distintas? Copia perfiles.ini.example como perfiles.ini y
# define un bloque por persona. Con perfiles.ini, MAIL_TO y las variables de abajo
# (PALABRAS_CLAVE, ENTIDADES, REGIONES, INFORME_COMPLETO) dejan de usarse.

# Palabras clave, separadas por coma. Cada una puede ser una palabra o una frase:
#   software                         la palabra y sus variantes (softwares)
#   sistema de seguridad ciudadana   todas esas palabras, en cualquier parte de la descripción
#   "sistema académico"              entre comillas: las palabras tienen que ir juntas
#                                    ("sistema de gestión académica" sí; "sistema de aire ... académicos" no)
# Escríbelas con tilde: el bot busca también la versión sin tilde ("maíz" busca "maiz").
# Si una frase trae resultados que no te sirven, ponla entre comillas o hazla más específica.
PALABRAS_CLAVE=software,"sistema académico",sistema de seguridad ciudadana

# Entidades que sigues, separadas por coma: sale TODO lo que tienen abierto (procedimientos y, si su
# región está en REGIONES, también sus contrataciones menores), sin filtrar por palabra clave.
# Basta una parte del nombre, sin importar tildes ni mayúsculas.
ENTIDADES=MUNICIPALIDAD PROVINCIAL DE LA CONVENCION,RED DE SERVICIOS DE SALUD LA CONVENCION

# Regiones que sigues, separadas por coma: todo lo abierto ahí (gobierno regional, municipalidades
# provinciales y distritales, redes de salud, UGEL, universidades...).
#   CUSCO               todo el departamento
#   APURIMAC/ABANCAY    solo esa provincia
REGIONES=CUSCO,MADRE DE DIOS,APURIMAC/ABANCAY,APURIMAC/COTABAMBAS

# si = todo en detalle cada día, aunque el correo sea largo (Gmail muestra "Ver mensaje completo").
# no = lo ya informado se resume en una línea y el correo se mantiene corto.
INFORME_COMPLETO=si
